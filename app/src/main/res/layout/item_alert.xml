<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Severity indicator strip -->
        <View
            android:id="@+id/viewSeverityStrip"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_alert_indicator" />

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Row 1: Alert type + Timestamp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvAlertType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SCREAM Detected"
                    android:textColor="@color/emergency_red"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvAlertTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:45:30"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Row 2: Node ID -->
            <TextView
                android:id="@+id/tvAlertNodeId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Node: abc123"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="2dp" />

            <!-- Row 3: GPS Coordinates & Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvAlertLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="11.0168, 76.9558"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Compass: Offline Navigation -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavigate"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Compass"
                        android:textColor="@color/info_blue"
                        android:textSize="11sp"
                        android:visibility="gone"
                        app:icon="@android:drawable/ic_menu_compass"
                        app:iconSize="14dp"
                        app:iconTint="@color/info_blue" />

                    <!-- Google Maps: Online Navigation -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogleMaps"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Maps"
                        android:textColor="@color/safe_green"
                        android:textSize="11sp"
                        android:visibility="gone"
                        app:icon="@android:drawable/ic_menu_mapmode"
                        app:iconSize="14dp"
                        app:iconTint="@color/safe_green" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 4: Metadata row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAlertConfidence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Conf: 92%"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvAlertBattery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Batt: 45%"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvAlertHops"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 hops"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Row 5: Mark as Rescued button (Hidden by default, shown for Rescuers) -->
            <Button
                android:id="@+id/btnMarkRescued"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/safe_green"
                android:text="Mark as Rescued"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:visibility="gone"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="6dp" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
